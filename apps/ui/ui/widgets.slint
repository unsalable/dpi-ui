// Sayfa iskeleti ve gruplu liste yapi taslari (iOS Ayarlar duzeni): sayfa, gezinme cubugu,
// grup, satir turleri, bildirim.

import { Theme, Type, Metrics, Motion, Curves } from "tokens.slint";
import { Icons } from "icons.slint";
import { Icon, Tile, Switch, TextButton, BackButton } from "components.slint";
import { AppState } from "state.slint";

/// Her ekranin zemini. Bos alanlara yapilan tiklamalari yutar (alttaki sayfaya gecmez);
/// ustune baska sayfa itildiginde hafifce kararir.
export component Page inherits Rectangle {
    /// 0..1: bu sayfanin ne kadarinin ustu kapandi (karartma icin).
    in property <float> covered: 0;
    background: Theme.bg;

    TouchArea {
        width: 100%;
        height: 100%;
    }

    @children

    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(clamp(root.covered, 0, 1) * (Theme.dark ? 0.45 : 0.1));
    }
}

/// Gezinme cubugu: geri dugmesi ve ortada baslik. Bos yeri pencereyi surukler.
export component NavBar inherits Rectangle {
    in property <string> title;
    in property <string> back-text;
    in property <bool> has-back: true;
    callback back();
    height: Metrics.navbar;

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                AppState.drag-window();
            }
        }
    }

    Text {
        x: 96px;
        width: parent.width - 192px;
        height: parent.height;
        text: root.title;
        color: Theme.label;
        font-size: Type.headline;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.has-back: BackButton {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.back-text;
        clicked => {
            root.back();
        }
    }
}

/// Grup: istege bagli ust baslik, yuvarlak koseli hucre zemini, istege bagli alt not.
export component Group inherits VerticalLayout {
    in property <string> header;
    in property <string> footer;
    in property <bool> footer-error: false;
    spacing: 0;

    if root.header != "": HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-bottom: 7px;
        Text {
            text: root.header;
            color: Theme.secondary;
            font-size: Type.footnote;
            letter-spacing: 0.3px;
        }
    }

    Rectangle {
        background: Theme.cell;
        border-radius: Metrics.group-radius;
        VerticalLayout {
            @children
        }
    }

    if root.footer != "": HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 7px;
        Text {
            text: root.footer;
            color: root.footer-error ? Theme.red : Theme.secondary;
            font-size: Type.footnote;
            wrap: word-wrap;
        }
    }
}

/// Satirlarin ortak zemini: uzerine gelme/basma vurgusu ve satir arasi ince cizgi.
/// Icerik satirin kendi yatay yerlesimine girer; satir icerige gore uzar.
/// Kose yuvarlakligini satirin kendisi cizer (yazilim cizici yuvarlak kirpmayi desteklemez).
export component RowBase inherits Rectangle {
    in property <bool> first: false;
    in property <bool> last: false;
    in property <bool> interactive: true;
    /// Ayirici cizginin soldan boslugu (simgeli satirlarda metnin hizasi).
    in property <length> inset: 16px;
    in property <length> pad-left: 16px;
    in property <length> pad-right: 14px;
    in property <length> pad-v: 0px;
    in property <length> gap: 12px;
    callback clicked();
    out property <bool> pressed: ta.pressed;
    min-height: Metrics.row;

    Rectangle {
        width: 100%;
        height: 100%;
        background: !root.interactive ? transparent : ta.pressed ? Theme.cell-pressed : ta.has-hover ? Theme.cell-hover : Theme.cell-hover.with-alpha(0);
        border-top-left-radius: root.first ? Metrics.group-radius : 0;
        border-top-right-radius: root.first ? Metrics.group-radius : 0;
        border-bottom-left-radius: root.last ? Metrics.group-radius : 0;
        border-bottom-right-radius: root.last ? Metrics.group-radius : 0;
        animate background { duration: Motion.fast; }
    }

    HorizontalLayout {
        padding-left: root.pad-left;
        padding-right: root.pad-right;
        padding-top: root.pad-v;
        padding-bottom: root.pad-v;
        spacing: root.gap;
        @children
    }

    if !root.last: Rectangle {
        x: root.inset;
        y: root.height - 1phx;
        width: root.width - root.inset;
        height: 1phx;
        background: Theme.separator;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

/// Simge karosu + baslik + deger + ok.
export component NavRow inherits RowBase {
    in property <string> icon;
    in property <bool> filled: true;
    in property <color> tint: Theme.gray;
    in property <string> title;
    in property <string> value;
    inset: 58px;
    gap: 14px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.value;

    VerticalLayout {
        alignment: center;
        Tile {
            icon: root.icon;
            filled: root.filled;
            tint: root.tint;
        }
    }

    Text {
        text: root.title;
        color: Theme.label;
        font-size: Type.body;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }

    Text {
        text: root.value;
        color: Theme.secondary;
        font-size: Type.body;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
        max-width: 170px;
    }

    VerticalLayout {
        alignment: center;
        Icon {
            commands: Icons.line-chevron;
            width: 14px;
            height: 14px;
            weight: 2.2px;
            tint: Theme.tertiary;
        }
    }
}

/// Baslik + aciklama + anahtar. Satirin tamamina tiklamak anahtari degistirir.
export component ToggleRow inherits RowBase {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> checked;
    callback toggled(bool);
    pad-v: 11px;
    accessible-role: switch;
    accessible-label: root.title;
    accessible-checkable: true;
    accessible-checked: root.checked;
    clicked => {
        root.toggled(!root.checked);
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.title;
            color: Theme.label;
            font-size: Type.body;
            wrap: word-wrap;
        }

        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.secondary;
            font-size: Type.footnote;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;
        Switch {
            checked: root.checked;
            pressed: root.pressed;
        }
    }
}

/// Secilebilir satir: secili olanin saginda mavi onay isareti.
export component CheckRow inherits RowBase {
    in property <string> title;
    in property <string> subtitle;
    in property <string> badge;
    in property <bool> selected;
    pad-v: 10px;
    accessible-role: list-item;
    accessible-label: root.title;
    accessible-item-selected: root.selected;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: root.title;
                color: Theme.label;
                font-size: Type.body;
                overflow: elide;
            }

            if root.badge != "": Text {
                text: root.badge;
                color: Theme.green;
                font-size: Type.footnote;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.secondary;
            font-size: Type.footnote;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;
        Icon {
            commands: Icons.line-check;
            width: 18px;
            height: 18px;
            weight: 2.4px;
            tint: Theme.blue.with-alpha(root.selected ? 1 : 0);
            animate tint { duration: Motion.fast; }
        }
    }
}

/// Baslik + secili deger; tiklayinca kucuk bir menu acilir (iOS acilir dugme).
export component PickerRow inherits RowBase {
    in property <string> title;
    in property <[string]> options;
    in property <int> current-index;
    callback selected(int);
    gap: 8px;
    accessible-role: combobox;
    accessible-label: root.title;
    accessible-value: root.options[root.current-index];
    clicked => {
        menu.show();
    }

    Text {
        text: root.title;
        color: Theme.label;
        font-size: Type.body;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }

    Text {
        text: root.options[root.current-index];
        color: Theme.secondary;
        font-size: Type.body;
        vertical-alignment: center;
        overflow: elide;
    }

    VerticalLayout {
        alignment: center;
        Icon {
            commands: Icons.line-updown;
            width: 14px;
            height: 14px;
            weight: 2px;
            tint: Theme.secondary;
        }

        menu := PopupWindow {
            x: -root.menu-width + 22px;
            y: root.height - 4px;
            width: root.menu-width;
            height: root.options.length * 34px + 10px;
            close-policy: close-on-click-outside;

            Rectangle {
                property <bool> shown: false;
                init => {
                    self.shown = true;
                }
                width: 100%;
                height: 100%;
                y: self.shown ? 0 : -8px;
                animate y { duration: 220ms * Motion.scale; easing: Curves.out; }
                background: Theme.elevated;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.elevated-stroke;

                VerticalLayout {
                    padding: 5px;
                    for option[index] in root.options: Rectangle {
                        height: 34px;
                        border-radius: 7px;
                        background: item.has-hover ? Theme.fill.with-alpha(0.8) : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    commands: Icons.line-check;
                                    width: 15px;
                                    height: 15px;
                                    weight: 2.2px;
                                    tint: Theme.label.with-alpha(index == root.current-index ? 1 : 0);
                                }
                            }

                            Text {
                                text: option;
                                color: Theme.label;
                                font-size: Type.body;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }

                        item := TouchArea {
                            clicked => {
                                root.selected(index);
                                menu.close();
                            }
                        }
                    }
                }
            }
        }
    }

    property <length> menu-width: 230px;
}

/// Satir boyunca tek bir eylem (mavi ya da yikici kirmizi metin).
export component ActionRow inherits RowBase {
    in property <string> text;
    in property <bool> destructive: false;
    in property <bool> busy: false;
    callback activated();
    accessible-role: button;
    accessible-label: root.text;
    interactive: !root.busy;
    clicked => {
        root.activated();
    }

    Text {
        text: root.text;
        color: root.busy ? Theme.secondary : root.destructive ? Theme.red : Theme.blue;
        font-size: Type.body;
        vertical-alignment: center;
    }
}

/// Yazi alani satiri; istege bagli sagda eylem dugmesi ("Ekle").
export component FieldRow inherits RowBase {
    in property <string> placeholder;
    in-out property <string> text;
    in property <string> action;
    callback accepted(string);
    callback edited(string);
    interactive: false;
    pad-right: 8px;
    gap: 8px;

    Rectangle {
        horizontal-stretch: 1;
        Text {
            width: 100%;
            height: 100%;
            text: root.placeholder;
            color: Theme.placeholder;
            font-size: Type.body;
            vertical-alignment: center;
            overflow: elide;
            visible: input.text == "";
        }

        input := TextInput {
            width: 100%;
            height: 100%;
            text <=> root.text;
            color: Theme.label;
            font-size: Type.body;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: Theme.blue.with-alpha(0.35);
            selection-foreground-color: Theme.label;
            accessible-label: root.placeholder;
            edited => {
                root.edited(self.text);
            }
            accepted => {
                root.accepted(self.text);
            }
        }
    }

    if root.action != "": VerticalLayout {
        alignment: center;
        TextButton {
            text: root.action;
            enabled: root.text != "";
            clicked => {
                root.accepted(root.text);
            }
        }
    }
}

/// Liste ogesi: ad, not ve kaldirma dugmesi.
export component ItemRow inherits RowBase {
    in property <string> name;
    in property <string> note;
    callback remove();
    interactive: false;
    pad-right: 8px;
    gap: 8px;

    Text {
        text: root.name;
        color: Theme.label;
        font-size: Type.body;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }

    if root.note != "": Text {
        text: root.note;
        color: Theme.secondary;
        font-size: Type.footnote;
        vertical-alignment: center;
        overflow: elide;
        max-width: 150px;
    }

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 15px;
            accessible-role: button;
            accessible-label: "Kaldır: " + root.name;
            background: x-ta.has-hover ? Theme.red.with-alpha(0.14) : transparent;
            Icon {
                commands: Icons.line-xmark;
                width: 15px;
                height: 15px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                weight: 2px;
                tint: x-ta.has-hover ? Theme.red : Theme.tertiary;
            }

            x-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.remove();
                }
            }
        }
    }
}

/// Baslik + deger; istege bagli bir baglanti (sagda dis baglanti simgesi).
export component ValueRow inherits RowBase {
    in property <string> title;
    in property <string> value;
    in property <bool> link: false;
    interactive: root.link;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.value;

    Text {
        text: root.title;
        color: Theme.label;
        font-size: Type.body;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }

    Text {
        text: root.value;
        color: Theme.secondary;
        font-size: Type.body;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
        max-width: 200px;
    }

    if root.link: VerticalLayout {
        alignment: center;
        Icon {
            commands: Icons.line-external;
            width: 15px;
            height: 15px;
            weight: 1.9px;
            tint: Theme.tertiary;
        }
    }
}

/// Bos liste satiri.
export component EmptyRow inherits RowBase {
    in property <string> text;
    interactive: false;
    Text {
        text: root.text;
        color: Theme.secondary;
        font-size: Type.body;
        vertical-alignment: center;
    }
}

/// Kisa sureli bildirim: alttan kayarak cikan hap.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    in property <int> serial;
    property <bool> shown: false;

    /// Testler icin: bildirim ekranda mi?
    out property <bool> visible-now: root.shown;

    changed serial => {
        self.shown = true;
        hide-timer.running = true;
        hide-timer.restart();
    }

    hide-timer := Timer {
        interval: 3600ms;
        running: false;
        triggered => {
            root.shown = false;
            self.running = false;
        }
    }

    /// Ekranin alt kenari; hap bunun 20 px ustunde durur, gizliyken asagida bekler.
    in property <length> bottom;
    height: content.preferred-height;
    y: root.shown ? root.bottom - self.height - 20px : root.bottom + 8px;
    animate y { duration: 480ms * Motion.scale; easing: root.shown ? Curves.spring : ease-in; }
    border-radius: min(self.height / 2, 20px);
    background: Theme.elevated;
    border-width: 1px;
    border-color: Theme.elevated-stroke;

    content := HorizontalLayout {
        padding-left: 16px;
        padding-right: 18px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 9px;
        if root.error: VerticalLayout {
            alignment: center;
            Path {
                width: 17px;
                height: 17px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.fill-warning;
                fill: Theme.red;
                fill-rule: evenodd;
            }
        }

        Text {
            text: root.text;
            color: Theme.label;
            font-size: Type.callout;
            font-weight: 500;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
    }

    TouchArea {
        enabled: root.shown;
        clicked => {
            root.shown = false;
        }
    }
}
