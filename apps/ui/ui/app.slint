import { Theme, Type, Metrics, Motion, Curves } from "tokens.slint";
import { Icons } from "icons.slint";
import { PowerState } from "connect.slint";
import { GlyphButton } from "components.slint";
import { Toast } from "widgets.slint";
import { AppState, Choice, HostItem, BenchItem, CategoryItem } from "state.slint";
import { HomePage, SettingsMenu, MethodPage, DnsPage, SitesPage, GeneralPage, AppearancePage, AboutPage } from "pages.slint";

export { PowerState, Theme, Type, Motion, AppState, Choice, HostItem, BenchItem, CategoryItem }

export component AppWindow inherits Window {
    title: "DPI UI";
    width: 400px;
    // Mac: ustte macOS'un pencere dugmeleri (trafik isiklari) icin seffaf cubuk payi.
    height: 640px + root.top-inset;
    no-frame: !AppState.mac;
    /// Artinca tum pencere yeniden cizilir (Windows icerigi attiginda: simge durumundan donus vb.).
    in-out property <int> repaint-epoch;
    background: root.repaint-epoch >= 0 ? Theme.bg : Theme.bg;
    default-font-family: Type.text;
    default-font-size: 14px;

    property <length> top-inset: AppState.mac ? 28px : 0px;

    /// 0 = ana ekran, 1 = ayarlar menusu, 2 = alt sayfa.
    in-out property <int> depth: 0;
    /// Alt sayfa: 1 yontem, 2 dns, 3 siteler, 4 genel, 5 gorunum, 6 hakkinda.
    in-out property <int> sub: 0;
    /// Alt sayfaya ana ekrandan dogrudan gelindiyse geri tusu ana ekrana doner.
    in-out property <bool> sub-from-home: false;

    callback minimize();
    callback close-window();
    /// Rust tarafi sayaclari yalnizca ana ekran gorunurken yeniler.
    callback page-changed(int, int);
    /// Testler icin: bildirim ekranda mi?
    out property <bool> toast-visible: toast.visible-now;
    /// Testler icin: ana ekranin ve ayarlar menusunun yatay konumu (gecis yonu).
    out property <length> home-x: home.x;
    out property <length> menu-x: menu.x;

    function go(d: int, s: int) {
        root.depth = d;
        root.sub = s;
        root.page-changed(d, s);
    }

    function back() {
        if (root.depth == 2 && root.sub-from-home) {
            root.sub-from-home = false;
            root.go(0, root.sub);
        } else {
            root.go(max(0, root.depth - 1), root.sub);
        }
    }

    // Ayarlar menusu, dugmesinin oldugu sol taraftan gelir; ana ekran %30 saga kayar ve kararir.
    // Alt sayfalar iOS itme gecisiyle sagdan gelir; alttaki sayfa %30 sola kayar ve kararir.
    property <length> w: self.width;
    property <bool> menu-shown: root.depth == 1 || (root.depth == 2 && !root.sub-from-home);

    body := Rectangle {
        y: root.top-inset;
        height: root.height - root.top-inset;
        clip: true;

        home := HomePage {
            x: root.depth == 0 ? 0px : root.menu-shown ? root.w * 0.3 : -root.w * 0.3;
            width: parent.width;
            height: parent.height;
            covered: root.depth == 0 ? 0 : 1;
            animate x, covered { duration: Motion.push; easing: Curves.push; }
            open-settings => {
                root.sub-from-home = false;
                root.go(1, root.sub);
            }
            open-method => {
                root.sub-from-home = true;
                root.go(2, 1);
            }
            open-dns => {
                root.sub-from-home = true;
                root.go(2, 2);
            }
        }

        // Karartma yalnizca ustune alt sayfa itilince: soldan gelirken ya da sola cekilirken kararmaz.
        menu := SettingsMenu {
            x: !root.menu-shown ? -root.w : root.depth == 1 ? 0px : -root.w * 0.3;
            width: parent.width;
            height: parent.height;
            covered: root.menu-shown && root.depth == 2 ? 1 : 0;
            animate x, covered { duration: Motion.push; easing: Curves.push; }
            back => {
                root.back();
            }
            open(page) => {
                root.go(2, page);
            }
        }

        MethodPage {
            x: root.depth == 2 && root.sub == 1 ? 0px : root.w;
            width: parent.width;
            height: parent.height;
            back-text: root.sub-from-home ? "" : @tr("Ayarlar");
            animate x { duration: Motion.push; easing: Curves.push; }
            back => {
                root.back();
            }
        }

        DnsPage {
            x: root.depth == 2 && root.sub == 2 ? 0px : root.w;
            width: parent.width;
            height: parent.height;
            back-text: root.sub-from-home ? "" : @tr("Ayarlar");
            animate x { duration: Motion.push; easing: Curves.push; }
            back => {
                root.back();
            }
        }

        SitesPage {
            x: root.depth == 2 && root.sub == 3 ? 0px : root.w;
            width: parent.width;
            height: parent.height;
            animate x { duration: Motion.push; easing: Curves.push; }
            back => {
                root.back();
            }
        }

        GeneralPage {
            x: root.depth == 2 && root.sub == 4 ? 0px : root.w;
            width: parent.width;
            height: parent.height;
            animate x { duration: Motion.push; easing: Curves.push; }
            back => {
                root.back();
            }
        }

        AppearancePage {
            x: root.depth == 2 && root.sub == 5 ? 0px : root.w;
            width: parent.width;
            height: parent.height;
            animate x { duration: Motion.push; easing: Curves.push; }
            back => {
                root.back();
            }
        }

        AboutPage {
            x: root.depth == 2 && root.sub == 6 ? 0px : root.w;
            width: parent.width;
            height: parent.height;
            animate x { duration: Motion.push; easing: Curves.push; }
            back => {
                root.back();
            }
        }

        // Pencere dugmeleri her sayfanin ustunde, ayni yerde durur. Mac'te macOS'un kendi
        // dugmeleri sol ustte.
        if !AppState.mac: HorizontalLayout {
            x: parent.width - self.width - 8px;
            y: 10px;
            width: self.preferred-width;
            height: 32px;
            spacing: 2px;
            GlyphButton {
                icon: Icons.line-minimize;
                icon-size: 15px;
                weight: 1.4px;
                label: @tr("Simge durumuna küçült");
                clicked => {
                    root.minimize();
                }
            }

            GlyphButton {
                icon: Icons.line-close;
                icon-size: 15px;
                weight: 1.4px;
                danger: true;
                label: @tr("Kapat");
                clicked => {
                    root.close-window();
                }
            }
        }

        toast := Toast {
            width: min(parent.width - 32px, self.preferred-width);
            x: (parent.width - self.width) / 2;
            bottom: parent.height;
            text: AppState.toast;
            error: AppState.toast-error;
            serial: AppState.toast-serial;
        }
    }
}
