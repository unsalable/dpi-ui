import { Theme, Metrics, Motion } from "tokens.slint";
import { Icons } from "icons.slint";
import { Orb, PowerState } from "orb.slint";
import { IconButton, Chip, Card, SettingRow, Select, Field, Segmented, Icon } from "components.slint";

export { PowerState, Theme }

component TitleBar inherits Rectangle {
    callback drag();
    callback settings();
    callback minimize();
    callback close-window();

    height: Metrics.titlebar-height;

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.drag();
            }
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 6px;
        spacing: 4px;

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.accent;
                }
            }

            Text {
                text: "GoodbyeDPI";
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 16px;
                    width: badge.preferred-width + 10px;
                    border-radius: 5px;
                    background: Theme.accent.with-alpha(0.14);
                    badge := Text {
                        text: "3";
                        color: Theme.accent;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.sliders;
                clicked => {
                    root.settings();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.minimize;
                clicked => {
                    root.minimize();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.close;
                danger-hover: true;
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

component SettingsPage inherits Rectangle {
    callback back();
    in-out property <int> theme-index: 1;
    callback theme-selected(int);

    background: Theme.bg;

    VerticalLayout {
        HorizontalLayout {
            height: 44px;
            padding-left: 8px;
            padding-right: 16px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.arrow-left;
                    clicked => {
                        root.back();
                    }
                }
            }

            Text {
                text: "Ayarlar";
                color: Theme.text;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        Flickable {
            VerticalLayout {
                alignment: start;
                padding: 16px;
                padding-top: 4px;
                spacing: 12px;

                Card {
                    heading: "GENEL";
                    SettingRow {
                        title: "Windows açılınca motoru başlat";
                        subtitle: "Oturum açmadan önce bile korur.";
                        checked: true;
                    }

                    SettingRow {
                        title: "Açılışta otomatik bağlan";
                        checked: true;
                    }

                    SettingRow {
                        title: "Kapatınca tepsiye küçült";
                        checked: true;
                    }
                }

                Card {
                    heading: "DNS";
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 6px;
                        Select {
                            options: ["Şifreli DNS · Cloudflare", "Şifreli DNS · Google", "Şifreli DNS · Quad9", "Şifreli DNS · AdGuard", "Yandex · 1253 yönlendirme", "Kapalı"];
                        }

                        Field {
                            placeholder: "Özel DoH adresi: https://dns.ornek.com/dns-query";
                        }
                    }
                }

                Card {
                    heading: "GÖRÜNÜM";
                    VerticalLayout {
                        padding-top: 6px;
                        Segmented {
                            options: ["Sistem", "Koyu", "Açık"];
                            current-index <=> root.theme-index;
                            selected(index) => {
                                root.theme-selected(index);
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "GoodbyeDPI UI 3";
    width: 400px;
    height: 640px;
    no-frame: true;
    background: Theme.bg;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    in-out property <PowerState> power-state: PowerState.off;
    in-out property <bool> settings-open: false;
    in-out property <string> method-name: "Ters sıra";
    in-out property <string> dns-name: "Cloudflare DoH";
    in-out property <string> uptime: "";

    callback power-clicked();
    callback drag-window();
    callback minimize();
    callback close-window();
    callback theme-selected(int);

    property <bool> is-on: root.power-state == PowerState.on;

    VerticalLayout {
        TitleBar {
            drag => {
                root.drag-window();
            }
            settings => {
                root.settings-open = !root.settings-open;
            }
            minimize => {
                root.minimize();
            }
            close-window => {
                root.close-window();
            }
        }

        body := Rectangle {
            clip: true;

            home := VerticalLayout {
                padding: 24px;
                padding-top: 8px;

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: center;
                    Orb {
                        state: root.power-state;
                        clicked => {
                            root.power-clicked();
                        }
                    }
                }

                Rectangle {
                    height: 24px;
                }

                Text {
                    text: root.power-state == PowerState.on ? "Korumalı" : root.power-state == PowerState.connecting ? "Bağlanıyor…" : root.power-state == PowerState.error ? "Bağlanamadı" : "Kapalı";
                    color: root.power-state == PowerState.on ? Theme.accent : root.power-state == PowerState.error ? Theme.danger : Theme.text;
                    font-size: 24px;
                    font-weight: 650;
                    horizontal-alignment: center;
                    animate color { duration: Motion.base; }
                }

                Rectangle {
                    height: 4px;
                }

                Text {
                    text: root.is-on ? root.uptime : root.power-state == PowerState.connecting ? "Motor başlatılıyor" : "Açmak için küreye dokun";
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 28px;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Chip {
                        label: "Yöntem";
                        value: root.method-name;
                        icon: Icons.bolt;
                    }

                    Chip {
                        label: "DNS";
                        value: root.dns-name;
                        icon: Icons.globe;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            commands: Icons.pulse;
                            width: 14px;
                            height: 14px;
                            tint: test-ta.has-hover ? Theme.accent : Theme.text-muted;
                        }
                    }

                    Text {
                        text: "Bağlantıyı test et";
                        color: test-ta.has-hover ? Theme.accent : Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        test-ta := TouchArea {
                            mouse-cursor: pointer;
                        }
                    }
                }
            }

            settings := SettingsPage {
                x: root.settings-open ? 0px : parent.width;
                y: 0px;
                width: parent.width;
                height: parent.height;
                animate x { duration: 280ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                back => {
                    root.settings-open = false;
                }
                theme-selected(index) => {
                    root.theme-selected(index);
                }
            }
        }
    }
}
