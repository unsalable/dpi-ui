import { Theme, Metrics, Motion } from "tokens.slint";
import { Icons } from "icons.slint";
import { PowerState } from "orb.slint";
import { IconButton } from "components.slint";
import { Toast } from "widgets.slint";
import { AppState, Choice, HostItem, BenchItem, CategoryItem } from "state.slint";
import { HomePage, SettingsMenu, MethodPage, DnsPage, SitesPage, GeneralPage, AppearancePage, AboutPage } from "pages.slint";

export { PowerState, Theme, AppState, Choice, HostItem, BenchItem, CategoryItem }

component TitleBar inherits Rectangle {
    callback drag();
    callback settings();
    callback minimize();
    callback close-window();

    height: Metrics.titlebar-height;

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.drag();
            }
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 6px;
        spacing: 4px;

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: AppState.power == PowerState.on ? Theme.accent : AppState.power == PowerState.error ? Theme.danger : Theme.text-muted;
                    animate background { duration: Motion.base; }
                }
            }

            Text {
                text: "GoodbyeDPI";
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 16px;
                    width: badge.preferred-width + 10px;
                    border-radius: 5px;
                    background: Theme.accent.with-alpha(0.14);
                    badge := Text {
                        text: "3";
                        color: Theme.accent;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.sliders;
                clicked => {
                    root.settings();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.minimize;
                clicked => {
                    root.minimize();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.close;
                danger-hover: true;
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "GoodbyeDPI UI 3";
    width: 400px;
    height: 640px;
    no-frame: true;
    background: Theme.bg;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    /// 0 = ana sayfa, 1 = ayarlar menusu, 2 = alt sayfa.
    in-out property <int> depth: 0;
    /// Alt sayfa: 1 yontem, 2 dns, 3 siteler, 4 genel, 5 gorunum, 6 hakkinda.
    in-out property <int> sub: 0;
    /// Alt sayfaya ana sayfadan dogrudan gelindiyse geri tusu ana sayfaya doner.
    property <bool> sub-from-home: false;

    callback drag-window();
    callback minimize();
    callback close-window();
    /// Pencere gorunur/gizli: Rust tarafi sayaclari yalnizca gorunurken yeniler.
    callback page-changed(int, int);

    function go(d: int, s: int) {
        root.depth = d;
        root.sub = s;
        root.page-changed(d, s);
    }

    function back() {
        if (root.depth == 2 && root.sub-from-home) {
            root.sub-from-home = false;
            root.go(0, root.sub);
        } else {
            root.go(max(0, root.depth - 1), root.sub);
        }
    }

    VerticalLayout {
        TitleBar {
            drag => {
                root.drag-window();
            }
            settings => {
                root.sub-from-home = false;
                root.go(root.depth == 0 ? 1 : 0, root.sub);
            }
            minimize => {
                root.minimize();
            }
            close-window => {
                root.close-window();
            }
        }

        body := Rectangle {
            clip: true;

            HomePage {
                x: root.depth >= 1 ? -parent.width * 0.25 : 0px;
                width: parent.width;
                height: parent.height;
                animate x { duration: 300ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                open-method => {
                    root.sub-from-home = true;
                    root.go(2, 1);
                }
                open-dns => {
                    root.sub-from-home = true;
                    root.go(2, 2);
                }
            }

            SettingsMenu {
                x: root.depth == 0 || (root.depth == 2 && root.sub-from-home) ? parent.width : root.depth == 1 ? 0px : -parent.width * 0.25;
                width: parent.width;
                height: parent.height;
                animate x { duration: 300ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                back => {
                    root.back();
                }
                open(page) => {
                    root.go(2, page);
                }
            }

            MethodPage {
                x: root.depth == 2 && root.sub == 1 ? 0px : parent.width;
                width: parent.width;
                height: parent.height;
                animate x { duration: 300ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                back => {
                    root.back();
                }
            }

            DnsPage {
                x: root.depth == 2 && root.sub == 2 ? 0px : parent.width;
                width: parent.width;
                height: parent.height;
                animate x { duration: 300ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                back => {
                    root.back();
                }
            }

            SitesPage {
                x: root.depth == 2 && root.sub == 3 ? 0px : parent.width;
                width: parent.width;
                height: parent.height;
                animate x { duration: 300ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                back => {
                    root.back();
                }
            }

            GeneralPage {
                x: root.depth == 2 && root.sub == 4 ? 0px : parent.width;
                width: parent.width;
                height: parent.height;
                animate x { duration: 300ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                back => {
                    root.back();
                }
            }

            AppearancePage {
                x: root.depth == 2 && root.sub == 5 ? 0px : parent.width;
                width: parent.width;
                height: parent.height;
                animate x { duration: 300ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                back => {
                    root.back();
                }
            }

            AboutPage {
                x: root.depth == 2 && root.sub == 6 ? 0px : parent.width;
                width: parent.width;
                height: parent.height;
                animate x { duration: 300ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                back => {
                    root.back();
                }
            }

            Toast {
                x: 16px;
                y: parent.height - self.height - 16px;
                width: parent.width - 32px;
                text: AppState.toast;
                error: AppState.toast-error;
                serial: AppState.toast-serial;
            }
        }
    }
}
