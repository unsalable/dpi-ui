import { Theme, Type, Motion } from "tokens.slint";
import { Icons } from "icons.slint";
import { PowerState } from "connect.slint";
import { GlyphButton } from "components.slint";
import { AppState, Choice, HostItem, BenchItem, CategoryItem } from "state.slint";
import { Shell } from "shell.slint";

export { PowerState, Theme, Type, Motion, AppState, Choice, HostItem, BenchItem, CategoryItem }

export component AppWindow inherits Window {
    title: "DPI UI";
    width: 400px;
    // Mac: ustte macOS'un pencere dugmeleri (trafik isiklari) icin seffaf cubuk payi.
    height: 640px + root.top-inset;
    no-frame: !AppState.mac;
    /// Artinca tum pencere yeniden cizilir (Windows icerigi attiginda: simge durumundan donus vb.).
    in-out property <int> repaint-epoch;
    background: root.repaint-epoch >= 0 ? Theme.bg : Theme.bg;
    default-font-family: Type.text;
    default-font-size: 14px;

    property <length> top-inset: AppState.mac ? 28px : 0px;

    /// 0 = ana ekran, 1 = ayarlar menusu, 2 = alt sayfa.
    in-out property <int> depth <=> body.depth;
    /// Alt sayfa: 1 yontem, 2 dns, 3 siteler, 4 genel, 5 gorunum, 6 hakkinda.
    in-out property <int> sub <=> body.sub;
    /// Alt sayfaya ana ekrandan dogrudan gelindiyse geri tusu ana ekrana doner.
    in-out property <bool> sub-from-home <=> body.sub-from-home;

    callback minimize();
    callback close-window();
    /// Rust tarafi sayaclari yalnizca ana ekran gorunurken yeniler.
    callback page-changed <=> body.page-changed;
    /// Testler icin: bildirim ekranda mi?
    out property <bool> toast-visible: body.toast-visible;
    /// Testler icin: ana ekranin ve ayarlar menusunun yatay konumu (gecis yonu).
    out property <length> home-x: body.home-x;
    out property <length> menu-x: body.menu-x;

    body := Shell {
        y: root.top-inset;
        height: root.height - root.top-inset;

        // Pencere dugmeleri her sayfanin ustunde, ayni yerde durur. Mac'te macOS'un kendi
        // dugmeleri sol ustte.
        if !AppState.mac: HorizontalLayout {
            x: parent.width - self.width - 8px;
            y: 10px;
            width: self.preferred-width;
            height: 32px;
            spacing: 2px;
            GlyphButton {
                icon: Icons.line-minimize;
                icon-size: 15px;
                weight: 1.4px;
                label: @tr("Simge durumuna küçült");
                clicked => {
                    root.minimize();
                }
            }

            GlyphButton {
                icon: Icons.line-close;
                icon-size: 15px;
                weight: 1.4px;
                danger: true;
                label: @tr("Kapat");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}
