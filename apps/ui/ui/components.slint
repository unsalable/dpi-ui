// Temel denetimler: simge, ayar karosu, anahtar, bolumlu secici, metin dugmesi,
// geri dugmesi ve pencere dugmeleri.

import { Theme, Type, Metrics, Motion, Curves } from "tokens.slint";
import { Icons } from "icons.slint";

/// Cizgi simgesi (24x24 izgara).
export component Icon inherits Path {
    in property <color> tint: Theme.label;
    in property <length> weight: 1.8px;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 18px;
    height: 18px;
    stroke: root.tint;
    stroke-width: root.weight;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

/// Ayar satirlarindaki renkli karo: yuvarlak kare zemin + beyaz simge.
export component Tile inherits Rectangle {
    in property <string> icon;
    /// true: dolgu simgesi, false: cizgi simgesi.
    in property <bool> filled: true;
    in property <color> tint: Theme.gray;
    width: Metrics.tile;
    height: Metrics.tile;
    border-radius: Metrics.tile-radius;
    background: root.tint;

    if root.filled: Path {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: Theme.on-tint;
        fill-rule: evenodd;
    }

    if !root.filled: Icon {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: root.icon;
        tint: Theme.on-tint;
        weight: 1.7px;
    }
}

/// iOS anahtari. Durumu disaridan gelir; dokunmayi satir yakalar.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> pressed;
    width: 46px;
    height: 28px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.green : Theme.fill;
    animate background { duration: Motion.base; }

    Rectangle {
        width: root.pressed ? 30px : 24px;
        height: 24px;
        y: 2px;
        x: root.checked ? root.width - self.width - 2px : 2px;
        border-radius: self.height / 2;
        background: #FFFFFF;
        border-width: Theme.dark ? 0 : 1px;
        border-color: #00000014;
        animate x, width { duration: 300ms * Motion.scale; easing: Curves.spring; }
    }
}

/// iOS bolumlu secici.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current-index;
    callback selected(int);

    property <length> cell: (self.width - 4px) / max(1, root.options.length);
    height: 32px;
    border-radius: Metrics.control-radius;
    background: Theme.segment-track;
    accessible-role: tab-list;

    Rectangle {
        x: 2px + root.current-index * root.cell;
        y: 2px;
        width: root.cell;
        height: root.height - 4px;
        border-radius: Metrics.control-radius - 2px;
        background: Theme.segment-thumb;
        border-width: 1px;
        border-color: Theme.segment-thumb-stroke;
        animate x { duration: 320ms * Motion.scale; easing: Curves.out; }
    }

    for option[index] in root.options: Rectangle {
        x: 2px + index * root.cell;
        y: 2px;
        width: root.cell;
        height: root.height - 4px;
        accessible-role: tab;
        accessible-label: option;
        accessible-item-selected: index == root.current-index;

        Text {
            text: option;
            color: Theme.label;
            font-size: Type.callout;
            font-weight: index == root.current-index ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (index != root.current-index) {
                    root.selected(index);
                }
            }
        }
    }
}

/// Mavi metin dugmesi (iOS "Ekle", "Kullan" gibi).
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> destructive: false;
    in property <length> font-size: Type.body;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    min-width: label.preferred-width + 12px;
    height: 30px;
    border-radius: 7px;
    background: ta.has-hover && root.enabled ? Theme.fill.with-alpha(0.6) : transparent;
    animate background { duration: Motion.fast; }

    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.tertiary : (root.destructive ? Theme.red : Theme.blue).with-alpha(ta.pressed ? 0.55 : 1);
        font-size: root.font-size;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// Gezinme cubugundaki geri dugmesi: mavi ok + onceki sayfanin adi. Yalnizca ok varsa
/// pencere dugmeleriyle ayni olcude (36x32) ve ok tam ortada durur.
export component BackButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text == "" ? @tr("Geri") : root.text;
    height: 32px;
    width: root.text == "" ? 36px : label.preferred-width + 34px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.fill.with-alpha(0.7) : transparent;
    animate background { duration: Motion.fast; }

    Icon {
        commands: Icons.line-back;
        width: 17px;
        height: 17px;
        x: root.text == "" ? (parent.width - self.width) / 2 : 6px;
        y: (parent.height - self.height) / 2;
        weight: 2.2px;
        tint: Theme.blue.with-alpha(ta.pressed ? 0.5 : 1);
    }

    label := Text {
        x: 25px;
        height: parent.height;
        visible: root.text != "";
        text: root.text;
        color: Theme.blue.with-alpha(ta.pressed ? 0.5 : 1);
        font-size: Type.headline;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// Simge dugmesi (ana ekrandaki ayarlar dugmesi ve pencere dugmeleri).
export component GlyphButton inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 16px;
    in property <length> weight: 1.6px;
    in property <bool> danger: false;
    in property <string> label;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    width: 36px;
    height: 32px;
    border-radius: 8px;
    background: ta.has-hover ? (root.danger ? Theme.red : Theme.fill.with-alpha(0.7)) : transparent;
    animate background { duration: Motion.fast; }

    Icon {
        commands: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        weight: root.weight;
        tint: ta.has-hover && root.danger ? #FFFFFF : ta.has-hover ? Theme.label : Theme.secondary;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
