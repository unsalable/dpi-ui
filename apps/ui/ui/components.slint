// Temel denetimler: simge, ayar karosu, anahtar, bolumlu secici, metin dugmesi,
// geri dugmesi ve pencere dugmeleri.

import { Theme, Type, Metrics, Motion, Curves } from "tokens.slint";
import { Icons } from "icons.slint";

/// Cizgi simgesi (24x24 izgara).
export component Icon inherits Path {
    in property <color> tint: Theme.label;
    in property <length> weight: 1.8px;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 18px;
    height: 18px;
    stroke: root.tint;
    stroke-width: root.weight;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

/// Ayar satirlarindaki renkli karo: yuvarlak kare zemin + beyaz simge.
export component Tile inherits Rectangle {
    in property <string> icon;
    /// true: dolgu simgesi, false: cizgi simgesi.
    in property <bool> filled: true;
    in property <color> tint: Theme.gray;
    width: Metrics.tile;
    height: Metrics.tile;
    border-radius: Metrics.tile-radius;
    background: root.tint;

    if root.filled: Path {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        fill: Theme.on-tint;
        fill-rule: evenodd;
    }

    if !root.filled: Icon {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: root.icon;
        tint: Theme.on-tint;
        weight: 1.7px;
    }
}

/// iOS anahtari. Durumu disaridan gelir; dokunmayi satir yakalar.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> pressed;
    width: 46px;
    height: 28px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.green : Theme.fill;
    animate background { duration: Motion.base; }

    Rectangle {
        width: root.pressed ? 30px : 24px;
        height: 24px;
        y: 2px;
        x: root.checked ? root.width - self.width - 2px : 2px;
        border-radius: self.height / 2;
        background: #FFFFFF;
        border-width: Theme.dark ? 0 : 1px;
        border-color: #00000014;
        animate x, width { duration: 300ms * Motion.scale; easing: Curves.spring; }
    }
}

/// iOS bolumlu secici.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current-index;
    callback selected(int);

    property <length> cell: (self.width - 4px) / max(1, root.options.length);
    height: 32px;
    border-radius: Metrics.control-radius;
    background: Theme.segment-track;
    accessible-role: tab-list;

    Rectangle {
        x: 2px + root.current-index * root.cell;
        y: 2px;
        width: root.cell;
        height: root.height - 4px;
        border-radius: Metrics.control-radius - 2px;
        background: Theme.segment-thumb;
        border-width: 1px;
        border-color: Theme.segment-thumb-stroke;
        animate x { duration: 320ms * Motion.scale; easing: Curves.out; }
    }

    for option[index] in root.options: Rectangle {
        x: 2px + index * root.cell;
        y: 2px;
        width: root.cell;
        height: root.height - 4px;
        accessible-role: tab;
        accessible-label: option;
        accessible-item-selected: index == root.current-index;

        Text {
            text: option;
            color: Theme.label;
            font-size: Type.callout;
            font-weight: index == root.current-index ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (index != root.current-index) {
                    root.selected(index);
                }
            }
        }
    }
}

/// Secim isareti (listelerde). Secilince soldan saga cizilir ve yayla yerine oturur; secim
/// kalkinca geri sarilarak soner. Cizgi: (4.5,12.8) -> (9.6,17.8) -> (19.5,6.5), 24'luk kutu;
/// parcalarin uzunlugu 7.142 ve 15.024.
export component CheckMark {
    in property <bool> on;
    in property <color> tint: Theme.blue;
    width: 18px;
    height: 18px;

    property <float> drawn: 0;
    property <float> pop: 0.7;
    property <float> alpha: 0;

    states [
        shown when root.on: {
            drawn: 1;
            pop: 1;
            alpha: 1;
            in {
                animate alpha { duration: 90ms * Motion.scale; }
                animate drawn { duration: 300ms * Motion.scale; delay: 30ms * Motion.scale; easing: Curves.out; }
                animate pop { duration: 460ms * Motion.scale; easing: spring(0.45); }
            }
        }
        hidden when !root.on: {
            drawn: 0;
            pop: 0.8;
            alpha: 0;
            in {
                animate alpha, pop { duration: 200ms * Motion.scale; easing: ease-in; }
                animate drawn { duration: 200ms * Motion.scale; easing: cubic-bezier(0.4, 0, 1, 1); }
            }
        }
    ]

    property <float> d: clamp(root.drawn, 0, 1) * 22.166;

    // Hep var (bosken hicbir sey cizmez): yalnizca gorunurken olusturulsaydi, ilk secimde
    // animasyonlu ozellikler ilk kez okunur ve animasyonsuz son degerden baslardi.
    Path {
        width: root.width * root.pop;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.d < 0.05
            ? ""
            : root.d <= 7.142
            ? "M 4.5 12.8 L " + (4.5 + 5.1 * root.d / 7.142) + " " + (12.8 + 5 * root.d / 7.142)
            : "M 4.5 12.8 L 9.6 17.8 L " + (9.6 + 9.9 * (root.d - 7.142) / 15.024) + " " + (17.8 - 11.3 * (root.d - 7.142) / 15.024);
        stroke: root.tint.with-alpha(root.alpha);
        stroke-width: 2.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}

/// Mavi metin dugmesi (iOS "Ekle", "Kullan" gibi).
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> destructive: false;
    in property <length> font-size: Type.body;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    min-width: label.preferred-width + 12px;
    height: 30px;
    border-radius: 7px;
    background: ta.has-hover && root.enabled ? Theme.fill.with-alpha(0.6) : transparent;
    animate background { duration: Motion.fast; }

    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.tertiary : (root.destructive ? Theme.red : Theme.blue).with-alpha(ta.pressed ? 0.55 : 1);
        font-size: root.font-size;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// Gezinme cubugundaki geri dugmesi: mavi ok + onceki sayfanin adi. Yalnizca ok varsa
/// pencere dugmeleriyle ayni olcude (36x32) ve ok tam ortada durur.
export component BackButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text == "" ? @tr("Geri") : root.text;
    height: 32px;
    width: root.text == "" ? 36px : label.preferred-width + 34px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.fill.with-alpha(0.7) : transparent;
    animate background { duration: Motion.fast; }

    Icon {
        commands: Icons.line-back;
        width: 17px;
        height: 17px;
        x: root.text == "" ? (parent.width - self.width) / 2 : 6px;
        y: (parent.height - self.height) / 2;
        weight: 2.2px;
        tint: Theme.blue.with-alpha(ta.pressed ? 0.5 : 1);
    }

    label := Text {
        x: 25px;
        height: parent.height;
        visible: root.text != "";
        text: root.text;
        color: Theme.blue.with-alpha(ta.pressed ? 0.5 : 1);
        font-size: Type.headline;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// Simge dugmesi (ana ekrandaki ayarlar dugmesi ve pencere dugmeleri).
export component GlyphButton inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 16px;
    in property <length> weight: 1.6px;
    in property <bool> danger: false;
    in property <string> label;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    width: 36px;
    height: 32px;
    border-radius: 8px;
    background: ta.has-hover ? (root.danger ? Theme.red : Theme.fill.with-alpha(0.7)) : transparent;
    animate background { duration: Motion.fast; }

    Icon {
        commands: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        weight: root.weight;
        tint: ta.has-hover && root.danger ? #FFFFFF : ta.has-hover ? Theme.label : Theme.secondary;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

/// Degisen metin: eskisi hafifce yukari kayarak soner, yenisi o neredeyse kaybolunca alttan
/// belirir (odeme ekranindaki "Isleniyor" -> "Tamam" gecisi gibi; farkli genislikteki iki yazi
/// ust uste binip okunmaz hale gelmez). Iki yuva sirayla kullanilir; tek bir sayac (n) ve ona
/// kayan p ikisini birlikte surer: gecisin ilerlemesi p - (n - 1).
export component FadeText {
    in property <string> text;
    in property <color> color;
    in property <length> font-size;
    in property <int> font-weight: 400;
    in property <string> font-family;
    in property <bool> wrap;

    property <string> a;
    property <string> b;
    /// Degisiklik sayisi; tekse b, ciftse a yuvasi gorunur.
    property <int> n;
    property <float> p: root.n;
    animate p { duration: 380ms * Motion.scale; }
    property <float> k: clamp(root.p - (root.n - 1), 0, 1);
    property <float> out-alpha: clamp(1 - root.k / 0.36, 0, 1);
    property <float> in-k: clamp((root.k - 0.4) / 0.6, 0, 1);
    /// ease-out-cubic
    property <float> in-ease: 1 - pow(1 - root.in-k, 3);
    property <bool> b-shown: Math.mod(root.n, 2) == 1;

    init => {
        root.a = root.text;
    }

    changed text => {
        if (Math.mod(root.n, 2) == 0) {
            root.b = root.text;
        } else {
            root.a = root.text;
        }
        root.n += 1;
    }

    // Yazi kadar yer kaplar; sayfanin bos alanini yutmaz (simge yerinden oynamasin).
    min-height: max(ta.preferred-height, tb.preferred-height);
    preferred-height: self.min-height;
    max-height: self.min-height;
    vertical-stretch: 0;

    ta := Text {
        width: root.width;
        y: root.b-shown ? -5px * root.k : 6px * (1 - root.in-ease);
        text: root.a;
        color: root.color.with-alpha(root.b-shown ? root.out-alpha : root.in-ease);
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-family: root.font-family;
        horizontal-alignment: center;
        wrap: root.wrap ? word-wrap : no-wrap;
    }

    tb := Text {
        width: root.width;
        y: root.b-shown ? 6px * (1 - root.in-ease) : -5px * root.k;
        text: root.b;
        color: root.color.with-alpha(root.b-shown ? root.in-ease : root.out-alpha);
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-family: root.font-family;
        horizontal-alignment: center;
        wrap: root.wrap ? word-wrap : no-wrap;
    }
}
