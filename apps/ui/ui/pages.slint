export component AboutPage inherits SubPage {
    title: @tr("Hakkında");

    VerticalLayout {
        padding-top: 36px;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            AppMark { }
        }

        VerticalLayout {
            spacing: 3px;
            Text {
                text: "DPI UI";
                color: Theme.label;
                font-family: Type.display;
                font-size: 20px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            Text {
                text: @tr("Sürüm {}", AppState.version);
                color: Theme.secondary;
                font-size: Type.callout;
                horizontal-alignment: center;
            }
        }
    }

    Group {
        ValueRow {
            first: true;
            title: @tr("Güncellemeler");
            value: AppState.update-text;
        }

        ActionRow {
            last: true;
            text: AppState.update-ready ? @tr("Şimdi yükle") : @tr("Şimdi denetle");
            busy: AppState.update-busy;
            activated => {
                if (AppState.update-ready) {
                    AppState.install-update();
                } else {
                    AppState.check-update();
                }
            }
        }
    }

    Group {
        footer: @tr("MIT lisanslı açık kaynak yazılım.");
        ValueRow {
            first: true;
            last: true;
            title: @tr("Kaynak kodu");
            value: "GitHub";
            link: true;
            clicked => {
                AppState.open-url("https://github.com/unsalable/dpi-ui");
            }
        }
    }
}
