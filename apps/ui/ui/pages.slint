// Ekranlar: ana ekran, ayarlar menusu ve alt sayfalar.

import { Theme, Type, Metrics, Motion, Curves } from "tokens.slint";
import { Icons } from "icons.slint";
import { ConnectGlyph, PowerState } from "connect.slint";
import { Icon, Tile, Segmented, GlyphButton, FadeText, CheckMark } from "components.slint";
import { Page, NavBar, DragArea, Group, NavRow, ToggleRow, CheckRow, PickerRow, ActionRow, FieldRow, ItemRow, EmptyRow, ValueRow } from "widgets.slint";
import { AppState, HostItem } from "state.slint";

// ================================================================== ana ekran

export component HomePage inherits Page {
    callback open-settings();
    callback open-method();
    callback open-dns();

    VerticalLayout {
        // Ust cubuk: solda ayarlar; sagdaki pencere dugmeleri ust katmanda.
        Rectangle {
            height: Metrics.navbar;
            DragArea { }

            Text {
                x: 96px;
                width: parent.width - 192px;
                height: parent.height;
                text: "DPI UI";
                color: Theme.label;
                font-size: Type.headline;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            GlyphButton {
                x: 10px;
                y: (parent.height - self.height) / 2;
                icon: Icons.line-gear;
                icon-size: 19px;
                weight: 1.5px;
                label: @tr("Ayarlar");
                clicked => {
                    root.open-settings();
                }
            }
        }

        if AppState.banner != "": HorizontalLayout {
            padding-left: Metrics.margin;
            padding-right: Metrics.margin;
            Rectangle {
                background: Theme.cell;
                border-radius: Metrics.group-radius;
                height: banner-row.preferred-height;
                banner-row := HorizontalLayout {
                    padding: 12px;
                    padding-left: 14px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: 20px;
                            height: 20px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Icons.fill-warning;
                            fill: Theme.orange;
                            fill-rule: evenodd;
                        }
                    }

                    Text {
                        text: AppState.banner;
                        color: Theme.label;
                        font-size: Type.callout;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            alignment: center;
            ConnectGlyph {
                state: AppState.power;
                label: AppState.status-title;
                clicked => {
                    if (AppState.service-missing) {
                        AppState.start-service();
                    } else {
                        AppState.power-toggle();
                    }
                }
            }
        }

        Rectangle {
            height: 10px;
        }

        // Durum degisince eski yazi soner, yenisi alttan belirir.
        FadeText {
            text: AppState.status-title;
            color: Theme.label;
            font-family: Type.display;
            font-size: Type.title;
            font-weight: 600;
        }

        Rectangle {
            height: 6px;
        }

        HorizontalLayout {
            padding-left: 40px;
            padding-right: 40px;
            FadeText {
                text: AppState.status-sub;
                color: Theme.secondary;
                font-size: Type.body;
                wrap: true;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            padding-left: Metrics.margin;
            padding-right: Metrics.margin;
            padding-bottom: 20px;
            Group {
                NavRow {
                    first: true;
                    icon: Icons.fill-bolt;
                    tint: Theme.orange;
                    title: @tr("Yöntem");
                    value: AppState.method-name;
                    clicked => {
                        root.open-method();
                    }
                }

                NavRow {
                    last: true;
                    icon: Icons.line-globe;
                    filled: false;
                    tint: Theme.blue;
                    title: "DNS";
                    value: AppState.dns-name;
                    clicked => {
                        root.open-dns();
                    }
                }
            }
        }
    }
}

// ================================================================== ayarlar menusu

export component SettingsMenu inherits Page {
    callback back();
    callback open(int);

    VerticalLayout {
        NavBar {
            back-text: "";
            back => {
                root.back();
            }
        }

        VerticalLayout {
            padding-left: Metrics.margin;
            padding-right: Metrics.margin;
            spacing: 24px;
            alignment: start;

            HorizontalLayout {
                padding-left: 4px;
                Text {
                    text: @tr("Ayarlar");
                    color: Theme.label;
                    font-family: Type.display;
                    font-size: Type.large-title;
                    font-weight: 700;
                }
            }

            Group {
                NavRow {
                    first: true;
                    icon: Icons.fill-bolt;
                    tint: Theme.orange;
                    title: @tr("Bağlantı yöntemi");
                    value: AppState.method-name;
                    clicked => {
                        root.open(1);
                    }
                }

                NavRow {
                    icon: Icons.line-globe;
                    filled: false;
                    tint: Theme.blue;
                    title: "DNS";
                    value: AppState.dns-name;
                    clicked => {
                        root.open(2);
                    }
                }

                NavRow {
                    last: true;
                    icon: Icons.line-list;
                    filled: false;
                    tint: Theme.teal;
                    title: @tr("Siteler");
                    value: AppState.scope-mode == 0 ? @tr("Akıllı liste") : @tr("Tüm trafik");
                    clicked => {
                        root.open(3);
                    }
                }
            }

            Group {
                NavRow {
                    first: true;
                    icon: Icons.fill-gear;
                    tint: Theme.gray;
                    title: @tr("Genel");
                    value: AppState.mac
                        ? (AppState.tray-at-login ? @tr("Mac açılınca başlar") : @tr("Elle başlar"))
                        : (AppState.start-with-windows ? @tr("Windows ile başlar") : @tr("Elle başlar"));
                    clicked => {
                        root.open(4);
                    }
                }

                NavRow {
                    last: true;
                    icon: Icons.fill-appearance;
                    tint: Theme.indigo;
                    title: @tr("Görünüm");
                    value: AppState.theme-index == 0 ? @tr("Sistem") : AppState.theme-index == 1 ? @tr("Koyu") : @tr("Açık");
                    clicked => {
                        root.open(5);
                    }
                }
            }

            Group {
                NavRow {
                    first: true;
                    last: true;
                    icon: Icons.fill-info;
                    tint: Theme.gray;
                    title: @tr("Hakkında");
                    value: AppState.version;
                    clicked => {
                        root.open(6);
                    }
                }
            }
        }
    }
}

// Alt sayfa iskeleti: gezinme cubugu + kaydirilabilir icerik.
component SubPage inherits Page {
    in property <string> title;
    in property <string> back-text: @tr("Ayarlar");
    callback back();

    VerticalLayout {
        NavBar {
            title: root.title;
            back-text: root.back-text;
            back => {
                root.back();
            }
        }

        // Icerik tercih ettigi yukseklikte kalir (aksi halde satirlar en kucuk boylarina sikisir).
        Flickable {
            content-height: max(self.height, content.preferred-height);
            content := VerticalLayout {
                alignment: start;
                padding-left: Metrics.margin;
                padding-right: Metrics.margin;
                padding-top: 6px;
                padding-bottom: 28px;
                spacing: 26px;
                @children
            }
        }
    }
}

// ================================================================== yontem

export component MethodPage inherits SubPage {
    title: @tr("Bağlantı yöntemi");
    /// Diger yontemler acildi mi? Secili yontem oradaysa liste hep acik durur.
    property <bool> more-open;
    property <bool> picked-in-more: AppState.method-index >= AppState.methods-main.length;
    property <bool> show-more: root.more-open || root.picked-in-more;

    // Mac: saglayiciya gore oneri yerine yontemler bu hatta denenir.
    if AppState.mac: Group {
        footer: @tr("Engelli siteleri her yöntemle dener, açanı seçer.");
        ActionRow {
            first: true;
            last: true;
            text: AppState.find-running ? @tr("Deneniyor…") : @tr("En iyi yöntemi bul");
            busy: AppState.find-running;
            activated => {
                AppState.find-method();
            }
        }
    }

    if !AppState.mac: Group {
        PickerRow {
            first: true;
            last: true;
            title: @tr("İnternet sağlayıcı");
            options: AppState.isp-names;
            current-index: AppState.isp-index;
            selected(index) => {
                AppState.select-isp(index);
            }
        }
    }

    // Saglayicinin yontemleri oneri sirasiyla; yalnizca secili satir ne yaptigini anlatir.
    Group {
        header: AppState.method-header;
        footer: @tr("Bir site açılmazsa sıradaki yöntemi dene.");
        for option[index] in AppState.methods-main: CheckRow {
            first: index == 0;
            last: index == AppState.methods-main.length - 1;
            title: option.title;
            subtitle: option.subtitle;
            subtitle-shown: index == AppState.method-index;
            badge: option.badge;
            selected: index == AppState.method-index;
            clicked => {
                AppState.select-method(index);
            }
        }
    }

    // Digerleri kapali baslar; acilinca satirlar yukaridan asagi acilir.
    if AppState.methods-more.length > 0: Group {
        header: @tr("DİĞER YÖNTEMLER");
        Rectangle {
            clip: true;
            height: root.show-more ? more-rows.preferred-height : 0px;
            animate height { duration: 360ms * Motion.scale; easing: Curves.push; }
            more-rows := VerticalLayout {
                y: 0;
                height: self.preferred-height;
                for option[index] in AppState.methods-more: CheckRow {
                    first: index == 0;
                    last: root.picked-in-more && index == AppState.methods-more.length - 1;
                    // Kapaliyken (ya da kapanirken) gorunmeyen satirlar tiklanmaz.
                    interactive: root.show-more;
                    title: option.title;
                    subtitle: option.subtitle;
                    subtitle-shown: AppState.methods-main.length + index == AppState.method-index;
                    badge: option.badge;
                    selected: AppState.methods-main.length + index == AppState.method-index;
                    clicked => {
                        AppState.select-method(AppState.methods-main.length + index);
                    }
                }
            }
        }

        if !root.picked-in-more: ActionRow {
            first: !root.show-more;
            last: true;
            text: root.show-more ? @tr("Daha az göster") : @tr("{} yöntem daha göster", AppState.methods-more.length);
            activated => {
                root.more-open = !root.more-open;
            }
        }
    }
}

// ================================================================== dns

export component DnsPage inherits SubPage {
    title: "DNS";
    property <string> custom-error;
    property <string> custom-name;
    property <string> custom-address;
    property <string> custom-bootstrap;

    VerticalLayout {
        spacing: 7px;
        Segmented {
            options: [@tr("Kapalı"), @tr("Şifreli"), @tr("Yönlendirme")];
            current-index: AppState.dns-mode;
            selected(index) => {
                AppState.set-dns-mode(index);
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            Text {
                text: AppState.dns-mode == 0
                    ? @tr("Sistem DNS'i kullanılır.")
                    : AppState.dns-mode == 1
                    ? @tr("Sorgular şifreli gider; sağlayıcın göremez.")
                    : @tr("Sorgular sunucunun farklı bir portuna yönlendirilir.");
                color: Theme.secondary;
                font-size: Type.footnote;
                wrap: word-wrap;
            }
        }
    }

    if AppState.dns-mode != 0: Group {
        header: @tr("SUNUCU");
        for option[index] in AppState.dns-providers: CheckRow {
            first: index == 0;
            last: index == AppState.dns-providers.length - 1;
            title: option.title;
            subtitle: option.subtitle;
            badge: option.badge;
            selected: index == AppState.dns-index;
            clicked => {
                AppState.select-dns(index);
            }
        }
    }

    if AppState.dns-mode == 1: Group {
        header: @tr("HIZ TESTİ");
        ActionRow {
            first: true;
            last: AppState.bench.length == 0;
            text: AppState.bench-running ? @tr("Ölçülüyor…") : AppState.bench.length == 0 ? @tr("Hızları ölç") : @tr("Yeniden ölç");
            busy: AppState.bench-running;
            activated => {
                AppState.run-bench();
            }
        }

        for item[i] in AppState.bench: Rectangle {
            min-height: Metrics.row;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 10px;
                Text {
                    text: item.name;
                    color: Theme.label;
                    font-size: Type.callout;
                    width: 92px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.fill;
                        Rectangle {
                            x: 0;
                            width: parent.width * (item.ok ? max(0.06, item.ratio) : 1.0);
                            height: parent.height;
                            border-radius: 3px;
                            background: !item.ok ? Theme.red.with-alpha(0.5) : i == 0 ? Theme.green : Theme.blue;
                            animate width { duration: 520ms * Motion.scale; easing: Curves.out; }
                        }
                    }
                }

                Text {
                    text: item.note;
                    color: item.ok ? Theme.secondary : Theme.red;
                    font-size: Type.footnote;
                    width: 50px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    use-btn := Rectangle {
                        width: use-label.preferred-width + 14px;
                        height: 28px;
                        border-radius: 7px;
                        background: use-ta.has-hover ? Theme.fill.with-alpha(0.6) : transparent;
                        use-label := Text {
                            text: @tr("Kullan");
                            color: item.ok ? Theme.blue : Theme.tertiary;
                            font-size: Type.callout;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        use-ta := TouchArea {
                            enabled: item.ok;
                            mouse-cursor: pointer;
                            clicked => {
                                AppState.use-bench(item.id);
                            }
                        }
                    }
                }
            }

            if i < AppState.bench.length - 1: Rectangle {
                x: 16px;
                y: parent.height - 1phx;
                width: parent.width - 16px;
                height: 1phx;
                background: Theme.separator;
            }
        }
    }

    if AppState.dns-mode != 0: Group {
        header: @tr("ÖZEL SUNUCU EKLE");
        footer: root.custom-error != "" ? root.custom-error : @tr("IP, IP:port ya da https:// / tls:// adresi.");
        footer-error: root.custom-error != "";
        FieldRow {
            first: true;
            placeholder: @tr("Ad (örn. Ev DNS)");
            text <=> root.custom-name;
            edited => {
                root.custom-error = "";
            }
        }

        FieldRow {
            placeholder: @tr("Adres");
            text <=> root.custom-address;
            edited => {
                root.custom-error = "";
            }
        }

        FieldRow {
            placeholder: @tr("Sunucu IP'si (yalnızca https / tls için)");
            text <=> root.custom-bootstrap;
            edited => {
                root.custom-error = "";
            }
        }

        ActionRow {
            last: true;
            text: @tr("Ekle ve kullan");
            activated => {
                root.custom-error = AppState.add-custom-dns(root.custom-name, root.custom-address, root.custom-bootstrap);
                if (root.custom-error == "") {
                    root.custom-name = "";
                    root.custom-address = "";
                    root.custom-bootstrap = "";
                }
            }
        }
    }

    if AppState.dns-mode != 0 && AppState.custom-dns.length > 0: Group {
        header: @tr("ÖZEL SUNUCULAR");
        for item[i] in AppState.custom-dns: ItemRow {
            first: i == 0;
            last: i == AppState.custom-dns.length - 1;
            name: item.name;
            note: item.note;
            remove => {
                AppState.remove-custom-dns(item.key);
            }
        }
    }

    if AppState.dns-mode == 1: Group {
        header: @tr("GÜVENLİK");
        ToggleRow {
            first: true;
            last: AppState.mac;
            title: @tr("Ulaşılamazsa sistem DNS'ine dön");
            checked: AppState.dns-fallback;
            toggled(v) => {
                AppState.set-dns-fallback(v);
            }
        }

        if !AppState.mac: ToggleRow {
            last: true;
            title: @tr("VPN bağlıyken DNS'e dokunma");
            checked: AppState.dns-skip-vpn;
            toggled(v) => {
                AppState.set-dns-skip-vpn(v);
            }
        }
    }
}

// ================================================================== siteler

// Alan adi listesi: ekleme satiri + silinebilir ogeler.
component HostGroup inherits Group {
    in property <string> placeholder;
    in property <[HostItem]> items;
    in property <string> hint;
    callback add(string) -> string;
    callback remove(string);
    property <string> error;
    property <string> draft;
    footer: root.error != "" ? root.error : root.hint;
    footer-error: root.error != "";

    FieldRow {
        first: true;
        last: root.items.length == 0;
        placeholder: root.placeholder;
        action: @tr("Ekle");
        text <=> root.draft;
        edited => {
            root.error = "";
        }
        accepted(value) => {
            root.error = root.add(value);
            if (root.error == "") {
                root.draft = "";
            }
        }
    }

    for item[i] in root.items: ItemRow {
        last: i == root.items.length - 1;
        name: item.name;
        note: item.note;
        remove => {
            root.remove(item.key);
        }
    }
}

export component SitesPage inherits SubPage {
    title: @tr("Siteler");

    VerticalLayout {
        spacing: 7px;
        Segmented {
            options: [@tr("Akıllı liste"), @tr("Tüm trafik")];
            current-index: AppState.scope-mode;
            selected(index) => {
                AppState.set-scope-mode(index);
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            Text {
                text: AppState.scope-mode == 0
                    ? @tr("Yalnızca engelli sitelere uygulanır.")
                    : @tr("Tüm HTTPS bağlantılarına uygulanır.");
                color: Theme.secondary;
                font-size: Type.footnote;
                wrap: word-wrap;
            }
        }
    }

    if AppState.scope-mode == 0 && !AppState.mac: Group {
        ToggleRow {
            first: true;
            last: true;
            title: @tr("Açılmayan siteleri kendiliğinden ekle");
            checked: AppState.learning;
            toggled(v) => {
                AppState.set-learning(v);
            }
        }
    }

    if AppState.scope-mode == 0: Group {
        header: @tr("HAZIR LİSTE");
        for cat[i] in AppState.categories: ToggleRow {
            first: i == 0;
            last: i == AppState.categories.length - 1;
            title: cat.title;
            checked: cat.checked;
            toggled(v) => {
                AppState.toggle-category(cat.id, v);
            }
        }
    }

    if AppState.scope-mode == 0: HostGroup {
        header: @tr("KENDİ SİTELERİM");
        placeholder: "site.com";
        items: AppState.targets;
        add(host) => {
            return AppState.add-target(host);
        }
        remove(host) => {
            AppState.remove-target(host);
        }
    }

    if AppState.scope-mode == 0 && !AppState.mac: Group {
        header: @tr("ÖĞRENİLENLER");
        if AppState.learned.length == 0: EmptyRow {
            first: true;
            last: true;
            text: @tr("Henüz öğrenilen site yok.");
        }

        for item[i] in AppState.learned: ItemRow {
            first: i == 0;
            name: item.name;
            note: item.note;
            remove => {
                AppState.forget-learned(item.key);
            }
        }

        if AppState.learned.length > 0: ActionRow {
            last: true;
            text: @tr("Tümünü unut");
            destructive: true;
            activated => {
                AppState.clear-learned();
            }
        }
    }

    HostGroup {
        header: @tr("ASLA DOKUNMA");
        placeholder: @tr("banka.com.tr");
        items: AppState.excluded;
        add(host) => {
            return AppState.add-excluded(host);
        }
        remove(host) => {
            AppState.remove-excluded(host);
        }
    }
}

// ================================================================== genel

export component GeneralPage inherits SubPage {
    title: @tr("Genel");

    Group {
        header: @tr("BAŞLANGIÇ");
        // Mac'te motor uygulamanin icinde: ayri bir hizmet baslatma ayari yok.
        if !AppState.mac: ToggleRow {
            first: true;
            title: @tr("Windows açılınca motoru başlat");
            checked: AppState.start-with-windows;
            toggled(v) => {
                AppState.set-start-with-windows(v);
            }
        }

        ToggleRow {
            first: AppState.mac;
            title: @tr("Açılışta otomatik bağlan");
            checked: AppState.auto-connect;
            toggled(v) => {
                AppState.set-auto-connect(v);
            }
        }

        ToggleRow {
            last: true;
            title: AppState.mac ? @tr("Mac açılınca menü çubuğunda başlat") : @tr("Oturum açılınca tepside başlat");
            checked: AppState.tray-at-login;
            toggled(v) => {
                AppState.set-tray-at-login(v);
            }
        }
    }

    Group {
        header: @tr("PENCERE");
        ToggleRow {
            first: true;
            last: true;
            title: AppState.mac ? @tr("Kapatınca menü çubuğunda kal") : @tr("Kapatınca tepside kal");
            checked: AppState.close-to-tray;
            toggled(v) => {
                AppState.set-close-to-tray(v);
            }
        }
    }

    Group {
        header: @tr("GÜNCELLEMELER");
        ToggleRow {
            first: true;
            last: true;
            title: @tr("Güncellemeleri otomatik yükle");
            checked: AppState.auto-update;
            toggled(v) => {
                AppState.set-auto-update(v);
            }
        }

    }

    Group {
        header: @tr("SORUN GİDERME");
        ActionRow {
            first: true;
            last: true;
            text: @tr("Günlüğü aç");
            activated => {
                AppState.open-logs();
            }
        }
    }
}

// ================================================================== gorunum

// Tema onizlemesi: kucuk bir ayarlar ekrani cizimi.
component MiniScreen inherits Rectangle {
    in property <bool> dark;
    background: root.dark ? #000000 : #F2F2F7;
    border-radius: 8px;
    for row[i] in 3: Rectangle {
        x: 6px;
        y: 16px + i * 22px;
        width: parent.width - 12px;
        height: 14px;
        border-radius: 4px;
        background: root.dark ? #2C2C2E : #FFFFFF;
    }
}

component ThemePreview inherits VerticalLayout {
    in property <string> label;
    /// 0 = sistem (yari yariya), 1 = koyu, 2 = acik
    in property <int> kind;
    in property <bool> selected;
    callback clicked();
    spacing: 8px;
    alignment: start;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.selected;

    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 76px;
            height: 112px;
            border-radius: 12px;
            border-width: root.selected ? 2.5px : 1px;
            border-color: root.selected ? Theme.blue : Theme.separator;
            animate border-color { duration: Motion.fast; }

            if root.kind != 0: MiniScreen {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                dark: root.kind == 1;
            }

            // Sistem: sol yari acik, sag yari koyu.
            if root.kind == 0: Rectangle {
                x: 4px;
                y: 4px;
                width: (parent.width - 8px) / 2;
                height: parent.height - 8px;
                clip: true;
                MiniScreen {
                    x: 0;
                    width: parent.width * 2;
                    height: parent.height;
                    dark: false;
                }
            }

            if root.kind == 0: Rectangle {
                x: parent.width / 2;
                y: 4px;
                width: (parent.width - 8px) / 2;
                height: parent.height - 8px;
                clip: true;
                MiniScreen {
                    x: -parent.width;
                    width: parent.width * 2;
                    height: parent.height;
                    dark: true;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.clicked();
                }
            }
        }
    }

    Text {
        text: root.label;
        color: Theme.label;
        font-size: Type.callout;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        // Secilince mavi dolgu ortadan yayla buyur, beyaz isaret cizilir.
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            border-width: 1.5px;
            border-color: Theme.tertiary.with-alpha(root.selected ? 0 : 1);
            animate border-color { duration: Motion.fast; }
            // Isaret dolgunun icinde ve onunla birlikte buyuyup kuculur; kalkarken disari tasmaz.
            Rectangle {
                property <length> d: 0px;
                states [
                    on when root.selected: {
                        d: 22px;
                        in {
                            animate d { duration: 420ms * Motion.scale; easing: spring(0.4); }
                        }
                    }
                    off when !root.selected: {
                        d: 0px;
                        in {
                            animate d { duration: 180ms * Motion.scale; easing: ease-in; }
                        }
                    }
                ]
                width: max(0px, self.d);
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: Theme.blue;

                CheckMark {
                    on: root.selected;
                    tint: #FFFFFF;
                    width: 14px * clamp(parent.width / 22px, 0, 1);
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.clicked();
                }
            }
        }
    }
}

export component AppearancePage inherits SubPage {
    title: @tr("Görünüm");

    Group {
        header: @tr("TEMA");
        HorizontalLayout {
            padding-top: 18px;
            padding-bottom: 16px;
            alignment: space-around;
            ThemePreview {
                label: @tr("Sistem");
                kind: 0;
                selected: AppState.theme-index == 0;
                clicked => {
                    AppState.select-theme(0);
                }
            }

            ThemePreview {
                label: @tr("Açık");
                kind: 2;
                selected: AppState.theme-index == 2;
                clicked => {
                    AppState.select-theme(2);
                }
            }

            ThemePreview {
                label: @tr("Koyu");
                kind: 1;
                selected: AppState.theme-index == 1;
                clicked => {
                    AppState.select-theme(1);
                }
            }
        }
    }

    // Dil adlari kendi dillerinde yazilir (cevrilmez).
    Group {
        header: @tr("DİL");
        CheckRow {
            first: true;
            title: @tr("Sistem");
            subtitle: AppState.mac ? @tr("Mac'in dilini kullanır") : @tr("Windows'un dilini kullanır");
            selected: AppState.language-index == 0;
            clicked => {
                AppState.select-language(0);
            }
        }

        CheckRow {
            title: "Türkçe";
            selected: AppState.language-index == 1;
            clicked => {
                AppState.select-language(1);
            }
        }

        CheckRow {
            last: true;
            title: "English";
            selected: AppState.language-index == 2;
            clicked => {
                AppState.select-language(2);
            }
        }
    }
}

