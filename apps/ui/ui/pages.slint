export component AboutPage inherits SubPage {
    title: "Hakkında";

    VerticalLayout {
        padding-top: 36px;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            AppMark { }
        }

        VerticalLayout {
            spacing: 3px;
            Text {
                text: "GoodbyeDPI UI 3";
                color: Theme.label;
                font-family: Type.display;
                font-size: 20px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            Text {
                text: "Sürüm " + AppState.version;
                color: Theme.secondary;
                font-size: Type.callout;
                horizontal-alignment: center;
            }
        }
    }

    Group {
        ValueRow {
            first: true;
            title: "Güncellemeler";
            value: AppState.update-text;
        }

        ActionRow {
            last: true;
            text: AppState.update-ready ? "Şimdi yükle" : "Şimdi denetle";
            busy: AppState.update-busy;
            activated => {
                if (AppState.update-ready) {
                    AppState.install-update();
                } else {
                    AppState.check-update();
                }
            }
        }
    }

    Group {
        footer: "MIT lisanslı açık kaynak yazılım.";
        ValueRow {
            first: true;
            last: true;
            title: "Kaynak kodu";
            value: "GitHub";
            link: true;
            clicked => {
                AppState.open-url("https://github.com/unsalable/dpi-ui");
            }
        }
    }
}
