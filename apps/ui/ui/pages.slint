// Ekranlar: ana ekran, ayarlar menusu ve alt sayfalar.

import { Theme, Type, Metrics, Motion, Curves } from "tokens.slint";
import { Icons } from "icons.slint";
import { ConnectGlyph, PowerState } from "connect.slint";
import { Icon, Tile, Segmented, GlyphButton } from "components.slint";
import { Page, NavBar, Group, NavRow, ToggleRow, CheckRow, PickerRow, ActionRow, FieldRow, ItemRow, EmptyRow, ValueRow } from "widgets.slint";
import { AppState, HostItem } from "state.slint";

// ================================================================== ana ekran

export component HomePage inherits Page {
    callback open-settings();
    callback open-method();
    callback open-dns();

    VerticalLayout {
        // Ust cubuk: solda ayarlar; sagdaki pencere dugmeleri ust katmanda.
        Rectangle {
            height: Metrics.navbar;
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        AppState.drag-window();
                    }
                }
            }

            GlyphButton {
                x: 10px;
                y: (parent.height - self.height) / 2;
                icon: Icons.line-gear;
                icon-size: 19px;
                weight: 1.5px;
                label: "Ayarlar";
                clicked => {
                    root.open-settings();
                }
            }
        }

        if AppState.banner != "": HorizontalLayout {
            padding-left: Metrics.margin;
            padding-right: Metrics.margin;
            Rectangle {
                background: Theme.cell;
                border-radius: Metrics.group-radius;
                height: banner-row.preferred-height;
                banner-row := HorizontalLayout {
                    padding: 12px;
                    padding-left: 14px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: 20px;
                            height: 20px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Icons.fill-warning;
                            fill: Theme.orange;
                            fill-rule: evenodd;
                        }
                    }

                    Text {
                        text: AppState.banner;
                        color: Theme.label;
                        font-size: Type.callout;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            alignment: center;
            ConnectGlyph {
                state: AppState.power;
                label: AppState.status-title;
                clicked => {
                    if (AppState.service-missing) {
                        AppState.start-service();
                    } else {
                        AppState.power-toggle();
                    }
                }
            }
        }

        Rectangle {
            height: 10px;
        }

        Text {
            text: AppState.status-title;
            color: Theme.label;
            font-family: Type.display;
            font-size: Type.title;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 6px;
        }

        HorizontalLayout {
            padding-left: 40px;
            padding-right: 40px;
            Text {
                text: AppState.status-sub;
                color: Theme.secondary;
                font-size: Type.body;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            padding-left: Metrics.margin;
            padding-right: Metrics.margin;
            padding-bottom: 20px;
            Group {
                NavRow {
                    first: true;
                    icon: Icons.fill-bolt;
                    tint: Theme.orange;
                    title: "Yöntem";
                    value: AppState.method-name;
                    clicked => {
                        root.open-method();
                    }
                }

                NavRow {
                    last: true;
                    icon: Icons.line-globe;
                    filled: false;
                    tint: Theme.blue;
                    title: "DNS";
                    value: AppState.dns-name;
                    clicked => {
                        root.open-dns();
                    }
                }
            }
        }
    }
}

// ================================================================== ayarlar menusu

export component SettingsMenu inherits Page {
    callback back();
    callback open(int);

    VerticalLayout {
        NavBar {
            back-text: "";
            back => {
                root.back();
            }
        }

        VerticalLayout {
            padding-left: Metrics.margin;
            padding-right: Metrics.margin;
            spacing: 24px;
            alignment: start;

            HorizontalLayout {
                padding-left: 4px;
                Text {
                    text: "Ayarlar";
                    color: Theme.label;
                    font-family: Type.display;
                    font-size: Type.large-title;
                    font-weight: 700;
                }
            }

            Group {
                NavRow {
                    first: true;
                    icon: Icons.fill-bolt;
                    tint: Theme.orange;
                    title: "Bağlantı yöntemi";
                    value: AppState.method-name;
                    clicked => {
                        root.open(1);
                    }
                }

                NavRow {
                    icon: Icons.line-globe;
                    filled: false;
                    tint: Theme.blue;
                    title: "DNS";
                    value: AppState.dns-name;
                    clicked => {
                        root.open(2);
                    }
                }

                NavRow {
                    last: true;
                    icon: Icons.line-list;
                    filled: false;
                    tint: Theme.teal;
                    title: "Siteler";
                    value: AppState.scope-mode == 0 ? "Akıllı liste" : "Tüm trafik";
                    clicked => {
                        root.open(3);
                    }
                }
            }

            Group {
                NavRow {
                    first: true;
                    icon: Icons.fill-gear;
                    tint: Theme.gray;
                    title: "Genel";
                    value: AppState.start-with-windows ? "Windows ile başlar" : "Elle başlar";
                    clicked => {
                        root.open(4);
                    }
                }

                NavRow {
                    last: true;
                    icon: Icons.fill-appearance;
                    tint: Theme.indigo;
                    title: "Görünüm";
                    value: AppState.theme-index == 0 ? "Sistem" : AppState.theme-index == 1 ? "Koyu" : "Açık";
                    clicked => {
                        root.open(5);
                    }
                }
            }

            Group {
                NavRow {
                    first: true;
                    last: true;
                    icon: Icons.fill-info;
                    tint: Theme.gray;
                    title: "Hakkında";
                    value: AppState.version;
                    clicked => {
                        root.open(6);
                    }
                }
            }
        }
    }
}

// Alt sayfa iskeleti: gezinme cubugu + kaydirilabilir icerik.
component SubPage inherits Page {
    in property <string> title;
    in property <string> back-text: "Ayarlar";
    callback back();

    VerticalLayout {
        NavBar {
            title: root.title;
            back-text: root.back-text;
            back => {
                root.back();
            }
        }

        // Icerik tercih ettigi yukseklikte kalir (aksi halde satirlar en kucuk boylarina sikisir).
        Flickable {
            content-height: max(self.height, content.preferred-height);
            content := VerticalLayout {
                alignment: start;
                padding-left: Metrics.margin;
                padding-right: Metrics.margin;
                padding-top: 6px;
                padding-bottom: 28px;
                spacing: 26px;
                @children
            }
        }
    }
}

// ================================================================== yontem

export component MethodPage inherits SubPage {
    title: "Bağlantı yöntemi";

    Group {
        footer: AppState.isps[AppState.isp-index].subtitle;
        PickerRow {
            first: true;
            last: true;
            title: "İnternet sağlayıcı";
            options: AppState.isp-names;
            current-index: AppState.isp-index;
            selected(index) => {
                AppState.select-isp(index);
            }
        }
    }

    Group {
        header: "YÖNTEM";
        footer: "Sağlayıcın için önerilen yöntem en üsttedir. Bir site açılmazsa sıradakini dene; değişiklik hemen uygulanır.";
        for option[index] in AppState.methods: CheckRow {
            first: index == 0;
            last: index == AppState.methods.length - 1;
            title: option.title;
            subtitle: option.subtitle;
            badge: option.badge;
            selected: index == AppState.method-index;
            clicked => {
                AppState.select-method(index);
            }
        }
    }
}

// ================================================================== dns

export component DnsPage inherits SubPage {
    title: "DNS";
    property <string> custom-error;
    property <string> custom-name;
    property <string> custom-address;
    property <string> custom-bootstrap;

    VerticalLayout {
        spacing: 7px;
        Segmented {
            options: ["Kapalı", "Şifreli", "Yönlendirme"];
            current-index: AppState.dns-mode;
            selected(index) => {
                AppState.set-dns-mode(index);
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            Text {
                text: AppState.dns-mode == 0
                    ? "Sistemin DNS ayarlarına dokunulmaz."
                    : AppState.dns-mode == 1
                    ? "Sorgular şifreli (DoH/DoT) gider; sağlayıcın göremez ve yönlendiremez. Ağ ayarların değişmez."
                    : "Sorgular seçilen sunucunun standart dışı portuna yönlendirilir (eski yöntem).";
                color: Theme.secondary;
                font-size: Type.footnote;
                wrap: word-wrap;
            }
        }
    }

    if AppState.dns-mode != 0: Group {
        header: "SUNUCU";
        for option[index] in AppState.dns-providers: CheckRow {
            first: index == 0;
            last: index == AppState.dns-providers.length - 1;
            title: option.title;
            subtitle: option.subtitle;
            selected: index == AppState.dns-index;
            clicked => {
                AppState.select-dns(index);
            }
        }
    }

    if AppState.dns-mode == 1: Group {
        header: "HIZ TESTİ";
        footer: "Her sağlayıcıya şifreli sorgular gönderip bu hattaki yanıt süresini ölçer.";
        ActionRow {
            first: true;
            last: AppState.bench.length == 0;
            text: AppState.bench-running ? "Ölçülüyor…" : AppState.bench.length == 0 ? "Hızları ölç" : "Yeniden ölç";
            busy: AppState.bench-running;
            activated => {
                AppState.run-bench();
            }
        }

        for item[i] in AppState.bench: Rectangle {
            min-height: Metrics.row;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 10px;
                Text {
                    text: item.name;
                    color: Theme.label;
                    font-size: Type.callout;
                    width: 92px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.fill;
                        Rectangle {
                            x: 0;
                            width: parent.width * (item.ok ? max(0.06, item.ratio) : 1.0);
                            height: parent.height;
                            border-radius: 3px;
                            background: !item.ok ? Theme.red.with-alpha(0.5) : i == 0 ? Theme.green : Theme.blue;
                            animate width { duration: 520ms * Motion.scale; easing: Curves.out; }
                        }
                    }
                }

                Text {
                    text: item.note;
                    color: item.ok ? Theme.secondary : Theme.red;
                    font-size: Type.footnote;
                    width: 50px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    use-btn := Rectangle {
                        width: use-label.preferred-width + 14px;
                        height: 28px;
                        border-radius: 7px;
                        background: use-ta.has-hover ? Theme.fill.with-alpha(0.6) : transparent;
                        use-label := Text {
                            text: "Kullan";
                            color: item.ok ? Theme.blue : Theme.tertiary;
                            font-size: Type.callout;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        use-ta := TouchArea {
                            enabled: item.ok;
                            mouse-cursor: pointer;
                            clicked => {
                                AppState.use-bench(item.id);
                            }
                        }
                    }
                }
            }

            if i < AppState.bench.length - 1: Rectangle {
                x: 16px;
                y: parent.height - 1phx;
                width: parent.width - 16px;
                height: 1phx;
                background: Theme.separator;
            }
        }
    }

    if AppState.dns-mode != 0: Group {
        header: "ÖZEL SUNUCU EKLE";
        footer: root.custom-error != "" ? root.custom-error : "IP (1.2.3.4 ya da 1.2.3.4:5353) ya da şifreli adres (https://… / tls://…) gir. Şifreli adreslerde sunucunun IP'si de gerekir.";
        footer-error: root.custom-error != "";
        FieldRow {
            first: true;
            placeholder: "Ad (örn. Ev DNS)";
            text <=> root.custom-name;
            edited => {
                root.custom-error = "";
            }
        }

        FieldRow {
            placeholder: "Adres";
            text <=> root.custom-address;
            edited => {
                root.custom-error = "";
            }
        }

        FieldRow {
            placeholder: "Sunucu IP'si (yalnızca https / tls için)";
            text <=> root.custom-bootstrap;
            edited => {
                root.custom-error = "";
            }
        }

        ActionRow {
            last: true;
            text: "Ekle ve kullan";
            activated => {
                root.custom-error = AppState.add-custom-dns(root.custom-name, root.custom-address, root.custom-bootstrap);
                if (root.custom-error == "") {
                    root.custom-name = "";
                    root.custom-address = "";
                    root.custom-bootstrap = "";
                }
            }
        }
    }

    if AppState.dns-mode != 0 && AppState.custom-dns.length > 0: Group {
        header: "ÖZEL SUNUCULAR";
        for item[i] in AppState.custom-dns: ItemRow {
            first: i == 0;
            last: i == AppState.custom-dns.length - 1;
            name: item.name;
            note: item.note;
            remove => {
                AppState.remove-custom-dns(item.key);
            }
        }
    }

    if AppState.dns-mode == 1: Group {
        header: "GÜVENLİK";
        ToggleRow {
            first: true;
            title: "Ulaşılamazsa sistem DNS'ine dön";
            subtitle: "Şifreli DNS geçici olarak erişilemezse internet kesilmez.";
            checked: AppState.dns-fallback;
            toggled(v) => {
                AppState.set-dns-fallback(v);
            }
        }

        ToggleRow {
            last: true;
            title: "VPN bağlıyken DNS'e dokunma";
            subtitle: "Kurum içi adlar ve VPN'in kendi DNS'i bozulmaz.";
            checked: AppState.dns-skip-vpn;
            toggled(v) => {
                AppState.set-dns-skip-vpn(v);
            }
        }
    }
}

// ================================================================== siteler

// Alan adi listesi: ekleme satiri + silinebilir ogeler.
component HostGroup inherits Group {
    in property <string> placeholder;
    in property <[HostItem]> items;
    in property <string> hint;
    callback add(string) -> string;
    callback remove(string);
    property <string> error;
    property <string> draft;
    footer: root.error != "" ? root.error : root.hint;
    footer-error: root.error != "";

    FieldRow {
        first: true;
        last: root.items.length == 0;
        placeholder: root.placeholder;
        action: "Ekle";
        text <=> root.draft;
        edited => {
            root.error = "";
        }
        accepted(value) => {
            root.error = root.add(value);
            if (root.error == "") {
                root.draft = "";
            }
        }
    }

    for item[i] in root.items: ItemRow {
        last: i == root.items.length - 1;
        name: item.name;
        note: item.note;
        remove => {
            root.remove(item.key);
        }
    }
}

export component SitesPage inherits SubPage {
    title: "Siteler";

    VerticalLayout {
        spacing: 7px;
        Segmented {
            options: ["Akıllı liste", "Tüm trafik"];
            current-index: AppState.scope-mode;
            selected(index) => {
                AppState.set-scope-mode(index);
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            Text {
                text: AppState.scope-mode == 0
                    ? "Yalnızca engelli bilinen sitelere uygulanır; bankalar, oyunlar ve diğer siteler hiç etkilenmez. En kararlı seçenek."
                    : "Her HTTPS bağlantısına uygulanır. Bazı site ve oyunlarda yan etki görülebilir; aşağıdaki istisna listesini kullan.";
                color: Theme.secondary;
                font-size: Type.footnote;
                wrap: word-wrap;
            }
        }
    }

    if AppState.scope-mode == 0: Group {
        footer: "Bir site DPI yüzünden yanıtsız kalırsa hemen atlatılır ve listeye eklenir.";
        ToggleRow {
            first: true;
            last: true;
            title: "Açılmayan siteleri kendiliğinden ekle";
            checked: AppState.learning;
            toggled(v) => {
                AppState.set-learning(v);
            }
        }
    }

    if AppState.scope-mode == 0: Group {
        header: "HAZIR LİSTE";
        for cat[i] in AppState.categories: ToggleRow {
            first: i == 0;
            last: i == AppState.categories.length - 1;
            title: cat.title;
            checked: cat.checked;
            toggled(v) => {
                AppState.toggle-category(cat.id, v);
            }
        }
    }

    if AppState.scope-mode == 0: HostGroup {
        header: "KENDİ SİTELERİM";
        placeholder: "site.com";
        hint: "Alt alan adları da dahil edilir.";
        items: AppState.targets;
        add(host) => {
            return AppState.add-target(host);
        }
        remove(host) => {
            AppState.remove-target(host);
        }
    }

    if AppState.scope-mode == 0: Group {
        header: "ÖĞRENİLENLER";
        if AppState.learned.length == 0: EmptyRow {
            first: true;
            last: true;
            text: "Henüz öğrenilen site yok.";
        }

        for item[i] in AppState.learned: ItemRow {
            first: i == 0;
            name: item.name;
            note: item.note;
            remove => {
                AppState.forget-learned(item.key);
            }
        }

        if AppState.learned.length > 0: ActionRow {
            last: true;
            text: "Tümünü unut";
            destructive: true;
            activated => {
                AppState.clear-learned();
            }
        }
    }

    HostGroup {
        header: "ASLA DOKUNMA";
        placeholder: "banka.com.tr";
        hint: "Bu sitelere hiçbir koşulda dokunulmaz.";
        items: AppState.excluded;
        add(host) => {
            return AppState.add-excluded(host);
        }
        remove(host) => {
            AppState.remove-excluded(host);
        }
    }
}

// ================================================================== genel

export component GeneralPage inherits SubPage {
    title: "Genel";

    Group {
        header: "BAŞLANGIÇ";
        ToggleRow {
            first: true;
            title: "Windows açılınca motoru başlat";
            subtitle: "Oturum açmadan önce bile korur; arayüz kapalıyken de çalışır.";
            checked: AppState.start-with-windows;
            toggled(v) => {
                AppState.set-start-with-windows(v);
            }
        }

        ToggleRow {
            title: "Açılışta otomatik bağlan";
            checked: AppState.auto-connect;
            toggled(v) => {
                AppState.set-auto-connect(v);
            }
        }

        ToggleRow {
            last: true;
            title: "Oturum açılınca tepside başlat";
            checked: AppState.tray-at-login;
            toggled(v) => {
                AppState.set-tray-at-login(v);
            }
        }
    }

    Group {
        header: "PENCERE";
        footer: AppState.close-to-tray
            ? "Pencereyi kapatınca uygulama saatin yanındaki tepside kalır. Tamamen çıkmak için tepsi simgesine sağ tıklayıp Çık'ı seç."
            : "Pencereyi kapatınca uygulama tamamen kapanır. Motor hizmeti ayarlarına göre çalışmaya devam eder.";
        ToggleRow {
            first: true;
            last: true;
            title: "Kapatınca tepside kal";
            checked: AppState.close-to-tray;
            toggled(v) => {
                AppState.set-close-to-tray(v);
            }
        }
    }

    Group {
        header: "GÜNCELLEMELER";
        footer: AppState.auto-update
            ? "Yeni sürüm GitHub'dan indirilir ve imzası doğrulanınca kurulum kendiliğinden başlar; Windows bir kez yönetici onayı ister."
            : "Yeni sürüm indirilip doğrulanır; kurulumu Hakkında sayfasından sen başlatırsın.";
        ToggleRow {
            first: true;
            title: "Güncellemeleri otomatik yükle";
            checked: AppState.auto-update;
            toggled(v) => {
                AppState.set-auto-update(v);
            }
        }

        ToggleRow {
            last: true;
            title: "Ön sürümleri de al";
            subtitle: "Beta ve test sürümleri de gelir.";
            checked: AppState.beta-updates;
            toggled(v) => {
                AppState.set-beta-updates(v);
            }
        }
    }

    Group {
        header: "SORUN GİDERME";
        footer: "Motorun son kayıtlarını gösterir; bir sorun bildirirken işe yarar.";
        ActionRow {
            first: true;
            last: true;
            text: "Günlüğü aç";
            activated => {
                AppState.open-logs();
            }
        }
    }
}

// ================================================================== gorunum

// Tema onizlemesi: kucuk bir ayarlar ekrani cizimi.
component MiniScreen inherits Rectangle {
    in property <bool> dark;
    background: root.dark ? #000000 : #F2F2F7;
    border-radius: 8px;
    for row[i] in 3: Rectangle {
        x: 6px;
        y: 16px + i * 22px;
        width: parent.width - 12px;
        height: 14px;
        border-radius: 4px;
        background: root.dark ? #2C2C2E : #FFFFFF;
    }
}

component ThemePreview inherits VerticalLayout {
    in property <string> label;
    /// 0 = sistem (yari yariya), 1 = koyu, 2 = acik
    in property <int> kind;
    in property <bool> selected;
    callback clicked();
    spacing: 8px;
    alignment: start;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.selected;

    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 76px;
            height: 112px;
            border-radius: 12px;
            border-width: root.selected ? 2.5px : 1px;
            border-color: root.selected ? Theme.blue : Theme.separator;
            animate border-color { duration: Motion.fast; }

            if root.kind != 0: MiniScreen {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                dark: root.kind == 1;
            }

            // Sistem: sol yari acik, sag yari koyu.
            if root.kind == 0: Rectangle {
                x: 4px;
                y: 4px;
                width: (parent.width - 8px) / 2;
                height: parent.height - 8px;
                clip: true;
                MiniScreen {
                    x: 0;
                    width: parent.width * 2;
                    height: parent.height;
                    dark: false;
                }
            }

            if root.kind == 0: Rectangle {
                x: parent.width / 2;
                y: 4px;
                width: (parent.width - 8px) / 2;
                height: parent.height - 8px;
                clip: true;
                MiniScreen {
                    x: -parent.width;
                    width: parent.width * 2;
                    height: parent.height;
                    dark: true;
                }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.clicked();
                }
            }
        }
    }

    Text {
        text: root.label;
        color: Theme.label;
        font-size: Type.callout;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            border-width: root.selected ? 0 : 1.5px;
            border-color: Theme.tertiary;
            background: root.selected ? Theme.blue : transparent;
            animate background { duration: Motion.fast; }
            Icon {
                commands: Icons.line-check;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                weight: 2.6px;
                tint: #FFFFFF.with-alpha(root.selected ? 1 : 0);
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.clicked();
                }
            }
        }
    }
}

export component AppearancePage inherits SubPage {
    title: "Görünüm";

    Group {
        header: "TEMA";
        footer: "Sistem, Windows'un açık/koyu ayarını izler.";
        HorizontalLayout {
            padding-top: 18px;
            padding-bottom: 16px;
            alignment: space-around;
            ThemePreview {
                label: "Sistem";
                kind: 0;
                selected: AppState.theme-index == 0;
                clicked => {
                    AppState.select-theme(0);
                }
            }

            ThemePreview {
                label: "Açık";
                kind: 2;
                selected: AppState.theme-index == 2;
                clicked => {
                    AppState.select-theme(2);
                }
            }

            ThemePreview {
                label: "Koyu";
                kind: 1;
                selected: AppState.theme-index == 1;
                clicked => {
                    AppState.select-theme(1);
                }
            }
        }
    }
}

