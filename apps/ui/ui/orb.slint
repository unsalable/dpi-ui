// Guc kuresi: uygulamanin imza ogesi. Tum gecisler tek seferlik; yalnizca
// "baglaniyor" durumunda yay doner ve o durum en fazla birkac saniye surer.

import { Theme, Motion } from "tokens.slint";
import { Icons } from "icons.slint";

export enum PowerState { off, connecting, on, error }

export component Orb {
    in property <PowerState> state: PowerState.off;
    callback clicked();

    width: 208px;
    height: 208px;

    property <bool> is-on: root.state == PowerState.on;
    property <bool> is-busy: root.state == PowerState.connecting;
    property <bool> is-error: root.state == PowerState.error;

    // Yayin uzunlugu (0..1) ve rengi.
    property <float> sweep: root.is-on || root.is-error ? 1.0 : root.is-busy ? 0.3 : 0.0;
    animate sweep { duration: 620ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    property <color> arc-color: root.is-error ? Theme.danger : root.is-busy ? Theme.accent-2 : Theme.accent;
    animate arc-color { duration: Motion.base; }

    property <float> glow: root.is-on ? 0.12 : root.is-error ? 0.08 : 0.0;
    animate glow { duration: Motion.slow; }

    property <angle> spin: 0deg;
    states [
        busy when root.is-busy: {
            spin: 360deg;
            in {
                animate spin { duration: 1100ms; iteration-count: -1; }
            }
        }
    ]

    // Yay geometrisi (100x100'luk gorunum kutusunda, yaricap 44).
    property <float> r: 44;
    property <angle> a0: root.spin;
    property <angle> a1: root.spin + min(root.sweep, 0.9999) * 360deg;
    property <float> x0: 50 + root.r * sin(root.a0);
    property <float> y0: 50 - root.r * cos(root.a0);
    property <float> x1: 50 + root.r * sin(root.a1);
    property <float> y1: 50 - root.r * cos(root.a1);
    property <int> large: root.sweep > 0.5 ? 1 : 0;

    // Dis parilti.
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        background: root.arc-color.with-alpha(root.glow);
    }

    // Iz halkasi.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 6 A 44 44 0 1 1 50 94 A 44 44 0 1 1 50 6";
        stroke: Theme.stroke;
        stroke-width: 6px;
        fill: transparent;
    }

    // Ilerleme yayi.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M " + root.x0 + " " + root.y0 + " A 44 44 0 " + root.large + " 1 " + root.x1 + " " + root.y1;
        stroke: root.arc-color.with-alpha(root.sweep > 0.01 ? 1 : 0);
        stroke-width: 6px;
        fill: transparent;
    }

    inner := Rectangle {
        width: ta.pressed ? 136px : ta.has-hover ? 150px : 144px;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.surface;
        border-width: 1px;
        border-color: root.is-on ? Theme.accent.with-alpha(0.35) : Theme.stroke;
        animate width { duration: Motion.base; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        animate border-color { duration: Motion.base; }

        Path {
            width: 48px;
            height: 48px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Icons.power;
            fill: transparent;
            stroke-width: 2.2px;
            stroke: root.is-on ? Theme.accent.with-alpha(0) : root.is-error ? Theme.danger : root.is-busy ? Theme.accent-2 : Theme.text-muted;
            animate stroke { duration: Motion.base; }
        }

        Path {
            width: 52px;
            height: 52px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Icons.check;
            fill: transparent;
            stroke-width: 2.4px;
            stroke: Theme.accent.with-alpha(root.is-on ? 1 : 0);
            animate stroke { duration: Motion.slow; }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
